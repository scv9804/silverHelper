# Copy to infra/.env, replace placeholders, and keep that file off Git.
DB_NAME=silverhelper
DB_USERNAME=silverhelper
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
HTTP_PORT=8088
AUTH_CALLBACK_URL=http://localhost:8088/auth/callback

# AWS HTTPS only: mount the full Certbot directory (live + archive symlinks).
# TLS_CERT_DIR=/etc/letsencrypt
# ACME_WEBROOT_DIR=/var/lib/silverhelper/acme

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PUBLIC_DATA_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
