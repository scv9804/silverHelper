# 복사해서 .env로 사용 (.env는 커밋하지 않음)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=silverhelper
DB_USERNAME=silverhelper
DB_PASSWORD=silverhelper

REDIS_HOST=localhost
REDIS_PORT=6379

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 인증: 운영에서는 JWT_SECRET(32바이트 이상)을 반드시 설정
JWT_SECRET=
AUTH_CALLBACK_URL=http://localhost:5173/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 메일: 로컬 Mailpit UI http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# 공공데이터포털 (data.go.kr) 인증키
PUBLIC_DATA_API_KEY=
